{
  "name": "saaskip",
  "version": "0.16.1",
  "description": "A Next.js SaaS foundation that won't break when you customize it. Zero-bug, fully tested and documented, safe to modify from day one. Built for business-critical, rock-solid products.",
  "keywords": [
    "nextjs",
    "nextjs-boilerplate",
    "saas",
    "saas-boilerplate",
    "starter",
    "template",
    "typescript",
    "react",
    "tailwindcss",
    "production-ready"
  ],
  "license": "MIT",
  "author": {
    "name": "oclio",
    "email": "hello@oclio.dev",
    "url": "https://oclio.dev"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node scripts/test.mjs",
    "test:watch": "vitest run --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:ui": "pnpm exec playwright test --ui",
    "test:e2e:report": "pnpm exec playwright show-report",
    "test:mutate": "stryker run",
    "test:mutate:only": "pnpm exec stryker run --mutate",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "check:types": "tsc --noEmit",
    "check:fast": "pnpm check:types && pnpm lint:fix && pnpm knip && true",
    "check:all": "pnpm check:fast && pnpm check:secrets && pnpm check:md && pnpm check:spell && pnpm build && true",
    "check:secrets": "gitleaks protect --staged --verbose",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:md": "markdownlint '**/*.md' --fix --ignore **/node_modules/** --ignore **/.next/**",
    "check:spell": "cspell '**/*.{ts,md,json,yml,yaml}' --no-progress --gitignore",
    "knip": "knip --config knip.config.mjs",
    "prepare": "husky",
    "commit": "cz",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "email:dev": "email dev",
    "sb": "storybook dev -p 6006",
    "sb:build": "storybook build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "sonar:sync": "node scripts/sonar-sync.mjs"
  },
  "dependencies": {
    "@arcjet/next": "^1.11.0",
    "@axiomhq/js": "^2.0.0",
    "@axiomhq/logging": "^0.4.0",
    "@axiomhq/nextjs": "^0.4.0",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@sentry/nextjs": "^10.72.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "better-auth": "^1.7.2",
    "better-auth-audit-logs": "^0.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "input-otp": "^1.5.0",
    "motion": "^13.2.0",
    "next": "16.3.3",
    "next-intl": "^4.14.1",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "resend": "^6.25.0",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.13.0",
    "@changesets/cli": "^3.0.1",
    "@chromatic-com/storybook": "^5.3.1",
    "@commitlint/config-conventional": "^21.2.2",
    "@next/bundle-analyzer": "^16.3.3",
    "@playwright/test": "^1.55.0",
    "@react-email/components": "^1.0.12",
    "@react-email/ui": "6.9.3",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.2",
    "cross-env": "^10.1.0",
    "cspell": "^10.1.1",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-storybook": "10.6.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unicorn": "^73.0.0",
    "gitleaks": "^1.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.32.3",
    "lint-staged": "^17.4.1",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-email": "^6.9.3",
    "storybook": "^10.6.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.md": [
      "markdownlint --fix --ignore CHANGELOG.md"
    ],
    "*.{ts,tsx,json,md,yml,yaml}": [
      "prettier --write",
      "cspell --no-must-find-files"
    ]
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
