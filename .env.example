# ─── ENVIRONMENT ──────────────────────────────────────────────────────────────
# OPTIONAL | The node environment | Default: development
NODE_ENV=development
# REQUIRED | Public app URL (client-side accessible)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# REQUIRED | PostgreSQL connection string for Drizzle ORM
# Local (Docker): postgresql://postgres:postgres@localhost:5455/db
# Prod (Neon/Vercel): postgresql://user:password@host/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5455/db
# OPTIONAL | The maximum number of connections in the pool | Default: 10
DATABASE_POOL_MAX=10
# OPTIONAL | The maximum time in seconds to keep idle connections | Default: 30
DATABASE_IDLE_TIMEOUT=30
# OPTIONAL | The maximum time in seconds to wait for a connection | Default: 10
DATABASE_CONNECT_TIMEOUT=10

# ─── AUTH ───────────────────────────────────────────────────────────────────
# REQUIRED | Secret key for Better Auth (32+ characters)
BETTER_AUTH_SECRET=dbNSbgAE0s8BhOp2nEzL4NTKWB48JAUU
# REQUIRED | Base URL of your app
BETTER_AUTH_URL=http://localhost:3000
# REQUIRED | GitHub OAuth Client ID for authentication
GITHUB_CLIENT_ID=ov23_client_id_placeholder
# REQUIRED | GitHub OAuth Client Secret for authentication
GITHUB_CLIENT_SECRET=github_client_secret_placeholder_value_32_chars
# REQUIRED | Google OAuth Client ID for authentication
GOOGLE_CLIENT_ID=1234567890-google_client_id_placeholder.apps.googleusercontent.com
# REQUIRED | Google OAuth Client Secret for authentication
GOOGLE_CLIENT_SECRET=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lder_value

# ─── SECURITY ─────────────────────────────────────────────────────────────────
# OPTIONAL | Arcjet API Key for rate limiting, bot protection, and email validation
ARCJET_KEY=ajkey_0123456789
# OPTIONAL | Arcjet Environment ('development', 'production', 'staging') | Default: development
ARCJET_ENV=development
# OPTIONAL | Comma-separated list of authorized email addresses for testing/whitelisting.
# If set, this restricts authentication, newsletter sign-ups, etc. (leave empty to disable restriction)
EMAIL_WHITELIST=tester1@example.com,tester2@example.com

# ─── OBSERVABILITY ────────────────────────────────────────────────────────────
# OPTIONAL/REQUIRED FOR BUILD | Sentry Auth Token to upload source maps.
# ⚠️ Place this in your local `.env.sentry-build-plugin` file.
SENTRY_AUTH_TOKEN=sntryu_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPTIONAL | Sentry DSN (client-side accessible, not a secret)
NEXT_PUBLIC_SENTRY_DSN=https://sentry.io/xxxxxxx
# OPTIONAL | Axiom API Token for telemetry and logging
AXIOM_TOKEN=xaat-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# OPTIONAL | Axiom Dataset name where logs will be stored
AXIOM_DATASET=smart
# OPTIONAL | Log level for Axiom logger | Default: info
LOG_LEVEL=info
# OPTIONAL | Generate a secure random token for healthz check endpoint
HEALTH_CHECK_SECRET=your-secure-random-token-here

# ─── MAILER ───────────────────────────────────────────────────────────────────
# REQUIRED | Resend API Key for sending emails
RESEND_API_KEY=re_123456789_placeholder_api_key_value
# REQUIRED | Sender email address
EMAIL_FROM=saaskip <no-reply@resend.dev>
